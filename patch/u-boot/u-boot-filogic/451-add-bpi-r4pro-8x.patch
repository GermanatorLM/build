From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GermanatorLM <noreply@github.com>
Date: Tue, 6 Oct 2026 00:00:00 +0200
Subject: [PATCH] mediatek: add Banana Pi BPI-R4 Pro 8X SD boot target

Add a deliberately small U-Boot device tree for the first Armbian bring-up.
Only serial console and the SD controller are required here; Linux uses the
full R4 Pro 8X device tree and overlays from Frank Wunderlich's 6.18 tree.

Keep Armbian's distro/extlinux boot flow so the generated image can use the
same GPT and /boot/extlinux/extlinux.conf layout as the existing BPI-R4 port.

---
 arch/arm/dts/mt7988-sd-bpi-r4pro.dts       | 74 +++++++++++++++++++++
 configs/mt7988a_bpir4pro_sd_defconfig       | 132 ++++++++++++++++++++++++++++
 2 files changed, 206 insertions(+)
 create mode 100644 arch/arm/dts/mt7988-sd-bpi-r4pro.dts
 create mode 100644 configs/mt7988a_bpir4pro_sd_defconfig

diff --git a/arch/arm/dts/mt7988-sd-bpi-r4pro.dts b/arch/arm/dts/mt7988-sd-bpi-r4pro.dts
new file mode 100644
index 0000000000..1111111111
--- /dev/null
+++ b/arch/arm/dts/mt7988-sd-bpi-r4pro.dts
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal Banana Pi BPI-R4 Pro SD boot description for Armbian.
+ * SD pin mapping follows Frank Wunderlich's R4 Pro U-Boot tree.
+ */
+
+/dts-v1/;
+#include "mt7988.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	model = "Banana Pi BPI-R4 Pro 8X";
+	compatible = "bananapi,bpi-r4-pro-8x",
+		     "bananapi,bpi-r4-pro",
+		     "mediatek,mt7988a";
+
+	chosen {
+		stdout-path = &uart0;
+	};
+
+	/*
+	 * BL2/DRAM init owns the real 8 GiB setup. Keep the same conservative
+	 * U-Boot-visible memory window used by the known-good MediaTek/Frank DTS.
+	 */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 0 0x10000000>;
+	};
+
+	reg_3p3v: regulator-3p3v {
+		compatible = "regulator-fixed";
+		regulator-name = "fixed-3.3V";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&pio {
+	mmc1_pins_default: mmc1default {
+		mux {
+			function = "flash";
+			groups = "emmc_45";
+		};
+
+		conf-cmd-dat {
+			pins = "SPI2_CSB", "SPI2_MISO", "SPI2_MOSI",
+			       "SPI2_CLK", "SPI2_HOLD";
+			input-enable;
+			drive-strength = <MTK_DRIVE_4mA>;
+		};
+
+		conf-clk {
+			pins = "SPI2_WP";
+			drive-strength = <MTK_DRIVE_4mA>;
+		};
+	};
+};
+
+&mmc0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc1_pins_default>;
+	max-frequency = <48000000>;
+	bus-width = <4>;
+	cap-sd-highspeed;
+	vmmc-supply = <&reg_3p3v>;
+	vqmmc-supply = <&reg_3p3v>;
+	status = "okay";
+};

+	mutex_unlock(&pl->state_mutex);
+
+	if (val == FWNODE_PCS_PROVIDER_DEL)
+		rtnl_unlock();
+
+	phylink_run_resolve(pl);
+
+	return NOTIFY_OK;
+}

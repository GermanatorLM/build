+	for (i = 0; i < ARRAY_SIZE(qparam.port_map); i++)
+		qparam.port_map[i] &= ~del_map[i];
+
+	if (mxl862xx_fw_portmap_is_empty(qparam.port_map)) {
+		ether_addr_copy(rparam.mac, addr);
+		rparam.fid = cpu_to_le16(fid);

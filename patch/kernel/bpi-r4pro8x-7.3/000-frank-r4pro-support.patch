+	      _pcwbits, _pd_reg, _pd_shift, _tuner_reg, _tuner_en_reg,       \
+	      _tuner_en_bit, _pcw_reg, _pcw_shift, _pcw_chg_reg, NULL,       \
+	      _parent_name)
+static const struct mtk_pll_div_table mt7987_arm_ll_div[] = {
+	{ .div = 0, .freq = 2000000000 },
+	{ .div = 1, .freq = 1500000000 },

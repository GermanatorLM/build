diff --git c/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-4e-wan-phy.dtso i/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-4e-wan-phy.dtso
new file mode 100644
index 0000000000000000000000000000000000000000..79da7bab89ab3c30bfbc0bd437aab1c2367acccd
--- /dev/null
+++ i/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-4e-wan-phy.dtso
@@ -0,0 +1,34 @@

From: GermanatorLM
Subject: [PATCH] arm64: dts: mediatek: expose R4 Pro 8X SPI-NAND as MTD

Expose the inherited SPI-NAND partitions for explicit access.
Remove automatic UBI attachment. Keep the flash layout unchanged.

diff --git a/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-8x.dts b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-8x.dts
--- a/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-8x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-8x.dts
@@ -15,6 +15,18 @@
 		     "mediatek,mt7988a";
 };
 
+&spi0 {
+	status = "okay";
+};
+
+&spi_nand {
+	partitions {
+		partition@200000 {
+			/delete-property/ compatible;
+		};
+	};
+};
+
 &gmac1 {
 	phy-mode = "usxgmii";
 	phy-connection-type = "usxgmii";

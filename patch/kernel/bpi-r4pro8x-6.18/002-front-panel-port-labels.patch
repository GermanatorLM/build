From: Armbian BPI-R4 Pro 8X port
Subject: [PATCH] arm64: dts: name 8X ports by front panel and enable FPC

Keep the shared R4 Pro tree unchanged. The manufacturer connects FPC to
internal switch port 3. GMAC hardware identities remain unchanged.

--- a/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-8x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-8x.dts
@@ -15,6 +15,16 @@
 		     "mediatek,mt7988a";
 };
 
+/* Front-panel numbering is specific to the 8X board. */
+&port0 { label = "lan1"; };
+&port1 { label = "lan2"; };
+&port2 { label = "lan3"; };
+&port3 { label = "lan4"; };
+&gsw_port0 { label = "lan5"; };
+&gsw_phy3 { status = "okay"; };
+&gsw_port3 { label = "fpc"; status = "okay"; };
+
+
 &eth {
 	mux: mux-bus {
 		#address-cells = <1>;
@@ -180,7 +190,7 @@
 	ports {
 		port6: port@6 {
 			reg = <12>;
-			label = "lan4";
+			label = "lan6";
 			phy-mode = "usxgmii";
 			phy-handle = <&phy24>;
 			status = "okay";
